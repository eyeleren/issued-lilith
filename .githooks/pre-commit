#!/bin/sh

[ -n "$SKIP_VERSION_BUMP" ] && exit 0

git_dir=$(git rev-parse --git-dir) || exit 0
root=$(git rev-parse --show-toplevel) || exit 0
pkg="$root/package.json"

[ -f "$pkg" ] || exit 0

if [ -f "$git_dir/MERGE_HEAD" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ] \
	|| [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
	exit 0
fi

current=$(awk -F'"' '/"version"[[:space:]]*:/ { print $4; exit }' "$pkg")

major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}

case "$current" in
	*.*.*) ;;
	*) echo "[version] package.json version '$current' is not x.y.z — left alone"; exit 0 ;;
esac
case "$major$minor" in
	''|*[!0-9]*) echo "[version] non-numeric version '$current' — left alone"; exit 0 ;;
esac

bumped="$major.$((minor + 1)).0"

tmp="$pkg.versionbump.$$"
awk -v nextver="$bumped" '
	!bumped && /"version"[[:space:]]*:/ {
		sub(/"version"[[:space:]]*:[[:space:]]*"[^"]*"/, "\"version\": \"" nextver "\"")
		bumped = 1
	}
	{ print }
' "$pkg" > "$tmp" || { rm -f "$tmp"; exit 1; }

if [ ! -s "$tmp" ]; then
	rm -f "$tmp"
	echo "[version] rewrite produced an empty file — aborting bump" >&2
	exit 1
fi

mv "$tmp" "$pkg" || { rm -f "$tmp"; exit 1; }
echo "[version] $current → $bumped"

git add "$pkg"
