# =============================================================================
# Lilith: configuration. Copy to .env (`make env`) and fill in.
# Empty values = feature disabled / default used. Never commit .env.
# =============================================================================

# --- Discord -----------------------------------------------------------------

# Bot token: Developer Portal » your app » Bot » Reset Token. REQUIRED.
DISCORD_TOKEN=

# Dev only: register slash commands on this guild (instant). Leave empty in
# production to register them globally (can take a while to show up the first time).
GUILD_ID=

# Comma-separated Discord user IDs allowed to use /restart and /hardban.
# (/hardban also works for anyone with the Administrator permission.)
ADMIN_IDS=

# Discord user ID of the bot's creator: their messages reach the model tagged [creatore],
# so the bot recognises them even if someone else copies their nickname.
CREATOR_ID=
# Creator's alias: the bot knows it and may use it besides their current display name.
CREATOR_NAME=

# debug | info | warn | error
LOG_LEVEL=info

# Where conversations, hardbans and state are stored. In Docker this is /app/data (set by compose).
DATA_DIR=./data

# --- LLM providers (OpenAI-compatible /chat/completions) ---------------------

# Ordered fallback list. For every NAME listed, set LLM_<NAME>_BASE_URL and
# LLM_<NAME>_MODEL (+ LLM_<NAME>_API_KEY if needed, LLM_<NAME>_TIMEOUT_MS optional).
# Empty = the bot starts, but always answers that the AI is offline.
LLM_PROVIDERS=groq,ollama

# Groq (primary). Key: https://console.groq.com/keys
# Available models depend on the account: list yours with
#   curl -H "Authorization: Bearer $KEY" https://api.groq.com/openai/v1/models
# openai/gpt-oss-120b is a production model; qwen/qwen3.8-27b is a (fast) preview model.
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-120b

# Ollama on your Mac (fallback). Ollama must listen on the LAN: OLLAMA_HOST=0.0.0.0 ollama serve
# Use the Mac's LAN IP (the NAS is a different machine than the Mac).
LLM_OLLAMA_BASE_URL=http://192.168.1.50:11434/v1
LLM_OLLAMA_MODEL=llama3.2
# Local models are slower: give them more time.
LLM_OLLAMA_TIMEOUT_MS=90000

# Other OpenAI-compatible examples (add the name to LLM_PROVIDERS to enable):
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=
# LLM_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default per-request timeout (ms) for providers without their own.
LLM_TIMEOUT_MS=30000
# On HTTP 429, wait and retry the same provider if retry-after <= this many
# seconds; otherwise skip to the next provider and pause this one.
LLM_MAX_RETRY_WAIT_S=10
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Reply sent when every provider fails.
OFFLINE_MESSAGE=⚠️ IA momentaneamente offline, riprova tra poco.

# --- Chat ---------------------------------------------------------------------

# Channels where Lilith chats (comma-separated IDs; threads inside them work too).
# Right click a channel » Copy Channel ID (needs Developer Mode in Discord settings).
CHANNELS=

# Answer in DMs.
ALLOW_DMS=true

# In CHANNELS, answer only when mentioned (replies to Lilith's messages always work).
REQUIRES_MENTION=true

# Messages kept per channel/DM (user + assistant). Keep it low on free tiers.
HISTORY_MAX_MESSAGES=20

# Max size of a text attachment read into the prompt (bytes, 0 = ignore attachments).
ATTACHMENT_MAX_BYTES=100000

# System prompt. Single line, use \n for new lines; <date> = current date/time.
# Alternative for long prompts: SYSTEM_FILE=./data/system.txt (takes precedence).
SYSTEM=Sei Lilith, un'assistente su un server Discord. Data e ora attuali: <date>.\nNei canali, i messaggi degli utenti iniziano con il loro nome seguito da due punti; tu rispondi senza prefisso.\nUsa il markdown di Discord (**grassetto**, _corsivo_, `codice`, blocchi ``` e liste). Niente tabelle, immagini o LaTeX.\nSe la conversazione è informale rispondi in poche frasi, a meno che non ti venga chiesto aiuto o una spiegazione.
SYSTEM_FILE=

# Text prepended to the first user message of each conversation (optional).
INITIAL_PROMPT=

# Show "start of conversation" note on the first reply.
SHOW_START_OF_CONVERSATION=false

# --- Presence & greeting --------------------------------------------------------

# Custom status text (empty = none).
ACTIVITY_MESSAGE=

# Channel for the login message (empty = no greeting). {role} = COMMANDER_ROLE_ID mention.
GREETING_CHANNEL_ID=
COMMANDER_ROLE_ID=
GREETING_MESSAGE=Lilith: LOGIN! A disposizione {role}

# --- Hardban --------------------------------------------------------------------

# Channel where re-bans and hardban changes are logged (optional).
MODLOG_CHANNEL_ID=

# --- Daily purge ------------------------------------------------------------------

# Channels emptied every day (first message and pinned messages are kept) and whose
# conversation memory is reset. Needs Manage Messages + Read Message History there.
DAILY_PURGE_CHANNELS=
# Local time (HH:MM) in the TZ below.
DAILY_PURGE_TIME=05:00
# Time zone for the schedule (the container defaults to UTC).
TZ=Europe/Rome

# --- Stable Diffusion (optional) -----------------------------------------------------

# AUTOMATIC1111 web UI started with --api (comma-separated for fallback).
# Empty = /text2img is not registered.
STABLE_DIFFUSION=
STABLE_DIFFUSION_TIMEOUT_MS=120000
