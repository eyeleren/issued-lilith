# Variables are documented in README.md › Configurazione.

# Discord
DISCORD_TOKEN=
GUILD_ID=
ADMIN_IDS=
CREATOR_ID=
CREATOR_NAME=
LOG_LEVEL=info
DATA_DIR=./data

# LLM
LLM_PROVIDERS=groq
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRY_WAIT_S=10
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
OFFLINE_MESSAGE=⚠️ IA momentaneamente offline, riprova tra poco.

# Chat
CHANNELS=
ALLOW_DMS=true
REQUIRES_MENTION=true
HISTORY_MAX_MESSAGES=20
ATTACHMENT_MAX_BYTES=100000
SYSTEM=
SYSTEM_FILE=
INITIAL_PROMPT=
SHOW_START_OF_CONVERSATION=false
MAX_EMOJIS=

# Presence & greeting
ACTIVITY_MESSAGE=
GREETING_CHANNEL_ID=
COMMANDER_ROLE_ID=
GREETING_MESSAGE=Lilith: LOGIN! A disposizione {role}

# Moderation
MODLOG_CHANNEL_ID=

# Daily purge
DAILY_PURGE_CHANNELS=
DAILY_PURGE_TIME=05:00
TZ=Europe/Rome

# /update via Watchtower
WATCHTOWER_URL=
WATCHTOWER_TOKEN=

# Stable Diffusion
STABLE_DIFFUSION=
STABLE_DIFFUSION_TIMEOUT_MS=120000
